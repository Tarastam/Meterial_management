# SQL Server connection used by the portable host.
DB_SERVER=sql-server-hostname-or-ip
DB_PORT=1433
DB_NAME=material_management
DB_USER=material_app_user
DB_PASSWORD=replace-with-a-strong-password
# Leave blank when the SQL Server default instance is used.
DB_INSTANCE=
# Set to false only for a trusted internal SQL Server with a legacy TLS certificate.
DB_ENCRYPT=true
DB_TRUST_SERVER_CERT=false

# Use a unique, strong password. This protects administration functions.
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Set this to true only when the portable host is behind HTTPS.
COOKIE_SECURE=false

# Keep the app local by default. A non-local host requires HTTPS and COOKIE_SECURE=true.
HOST=127.0.0.1
