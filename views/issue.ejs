<%- include('partials/head', { title: 'Record Data - Material Management' }) %>
<h1>Record Data</h1>

<% if (error) { %><div class="alert error"><%= error %></div><% } %>
<% if (success) { %><div class="alert success">Issue entries recorded successfully.</div><% } %>
<% if (negativeUsage) { %>
<div class="alert error">
  <strong>Not saved — usage would come out negative for these materials. Correct the Current Stock / Issue values before submitting:</strong>
  <ul>
    <% negativeUsage.forEach(w => { %>
    <li><%= w.code %> - <%= w.name %>: usage <%= fmtNum(w.usage) %></li>
    <% }) %>
  </ul>
</div>
<% } %>

<div class="filters">
  <form method="get" action="/issue" style="display:contents;">
    <div class="field" style="margin-bottom:0;">
      <label>Workshop</label>
      <select name="workshop" onchange="this.form.submit()">
        <option value="">All Workshops</option>
        <% workshops.forEach(w => { %>
        <option value="<%= w %>" <%= w === selectedWorkshop ? 'selected' : '' %>><%= w %></option>
        <% }) %>
      </select>
    </div>
    <div class="field" style="margin-bottom:0;">
      <label>Date</label>
      <input type="date" name="date" value="<%= entryDate %>" max="<%= today %>" onchange="this.form.submit()">
    </div>
  </form>
  <div class="field" style="margin-bottom:0; max-width:420px;">
    <label>Search</label>
    <input type="text" id="materialSearch" placeholder="Filter by code or name" oninput="filterIssueRows(this.value)">
  </div>
</div>
<% if (entryDate !== today) { %>
<div class="alert error">Backdating entries to <%= entryDate %>.</div>
<% } %>

<% if (!materials.length) { %>
<div class="card empty-state">No materials found. <a href="/materials/new">Add a material first</a>.</div>
<% } else { %>
<form method="post" action="/issue">
  <input type="hidden" name="workshop" value="<%= selectedWorkshop %>">
  <input type="hidden" name="entry_date" value="<%= entryDate %>">
  <div class="table-wrap">
    <table class="issue-table">
      <thead>
        <tr>
          <th>Code</th><th class="col-erp">ERP Code</th><th class="col-name">Name</th><th class="col-center">Unit</th><th class="col-center">Workshop</th>
          <th class="col-input" title="If left blank, the previous day's value is saved automatically">Current Stock</th><th class="col-input">Issue</th><th class="col-input">Issue NCN</th><th class="col-input">Return NCN</th>
          <th class="col-num" title="Live preview: stock yesterday + issue - current stock - issue NCN + return NCN">Usage</th>
        </tr>
      </thead>
      <tbody>
        <% materials.forEach(m => { %>
        <% const v = values[m.id] || {}; %>
        <tr data-search="<%= (m.prod_material_code + ' ' + m.material_code + ' ' + m.name).toLowerCase() %>">
          <td><%= m.prod_material_code %></td>
          <td class="col-erp"><%= m.material_code %></td>
          <td class="col-name"><%= m.name %></td>
          <td class="col-center"><%= m.unit %></td>
          <td class="col-center"><%= m.workshop %></td>
          <td class="col-input"><input class="usage-input" type="number" step="any" min="0" name="current_stock_<%= m.id %>" value="<%= v.current_stock || '' %>" placeholder="<%= stockMap[m.id] != null ? fmtNum(stockMap[m.id]) : '' %>" data-stock-yesterday="<%= stockMap[m.id] != null ? stockMap[m.id] : 0 %>"></td>
          <td class="col-input"><input class="usage-input" type="number" step="any" min="0" name="issue_qty_<%= m.id %>" value="<%= v.issue_qty || '' %>"></td>
          <td class="col-input"><input class="usage-input" type="number" step="any" min="0" name="issue_ncn_<%= m.id %>" value="<%= v.issue_ncn || '' %>"></td>
          <td class="col-input"><input class="usage-input" type="number" step="any" min="0" name="return_ncn_<%= m.id %>" value="<%= v.return_ncn || '' %>"></td>
          <td class="col-num usage-cell" data-usage-for="<%= m.id %>" data-decimals="<%= m.decimal_places != null ? m.decimal_places : 3 %>">-</td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <div class="issue-footer">
    <div class="field">
      <label>Employee ID *</label>
      <input type="text" name="employee_id" pattern="\d{7}|admin" maxlength="7" placeholder="7-digit ID" value="<%= employeeId %>" required>
    </div>
    <div class="field">
      <label>Shift *</label>
      <select name="shift" required>
        <option value="">Select shift...</option>
        <% shifts.forEach(s => { %>
        <option value="<%= s %>" <%= shift === s ? 'selected' : '' %>><%= s %></option>
        <% }) %>
      </select>
    </div>
    <button class="btn" type="submit">Submit</button>
  </div>
</form>
<script>
function filterIssueRows(query) {
  const q = query.trim().toLowerCase();
  document.querySelectorAll('.issue-table tbody tr').forEach(row => {
    row.style.display = !q || row.dataset.search.includes(q) ? '' : 'none';
  });
}

// Live Usage preview. Mirrors the server formula
// (usage = stockYesterday + issue - stockToday - issueNcn + returnNcn) and the
// carry-forward default applied in POST /issue when Current Stock is left blank.
// Preview only: the server's guard also adds in any existing same-day rows, which this
// can't see. That only differs on the admin/backdate path, since the duplicate guard
// blocks same-day re-entry for everyone else. The server stays the authority.
(function () {
  var FIELDS = ['current_stock', 'issue_qty', 'issue_ncn', 'return_ncn'];
  var form = document.querySelector('form[action="/issue"][method="post"]');
  if (!form) return;
  var submitBtn = form.querySelector('.issue-footer button[type="submit"]');

  // Mirrors server.js's fmtNum.
  function fmtUsage(n, decimals) {
    return Number(n).toLocaleString(undefined, { minimumFractionDigits: 0, maximumFractionDigits: decimals });
  }

  function numOf(input) {
    var n = parseFloat(input.value);
    return isNaN(n) ? 0 : n;
  }

  function recalcRow(tr) {
    var cell = tr.querySelector('.usage-cell');
    if (!cell) return;
    var inputs = {};
    for (var i = 0; i < FIELDS.length; i++) {
      inputs[FIELDS[i]] = tr.querySelector('input[name^="' + FIELDS[i] + '_"]');
    }
    if (!inputs.current_stock) return;

    // An untouched row is skipped entirely on submit, so it has no usage to show.
    var touched = FIELDS.some(function (f) {
      return inputs[f] && inputs[f].value.trim() !== '';
    });
    if (!touched) {
      cell.textContent = '-';
      cell.classList.remove('usage-negative');
      return;
    }

    var stockYesterday = parseFloat(inputs.current_stock.dataset.stockYesterday) || 0;
    var stockToday = inputs.current_stock.value.trim() === '' ? stockYesterday : numOf(inputs.current_stock);
    var usage = stockYesterday + numOf(inputs.issue_qty) - stockToday
      - numOf(inputs.issue_ncn) + numOf(inputs.return_ncn);

    var decimals = parseInt(cell.dataset.decimals, 10);
    if (isNaN(decimals)) decimals = 3;
    cell.textContent = fmtUsage(usage, decimals);
    cell.classList.toggle('usage-negative', usage < 0);
  }

  function refreshSubmit() {
    if (!submitBtn) return;
    var bad = form.querySelectorAll('.usage-cell.usage-negative').length;
    submitBtn.disabled = bad > 0;
    submitBtn.title = bad > 0
      ? 'Usage is negative for ' + bad + ' material(s). Correct the values before submitting.'
      : '';
  }

  form.addEventListener('input', function (e) {
    if (!e.target.classList.contains('usage-input')) return;
    var tr = e.target.closest('tr');
    if (!tr) return;
    recalcRow(tr);
    refreshSubmit();
  });

  // The page re-renders with the submitted values after a validation error, so the
  // column and the disabled state have to be right before any typing happens.
  form.querySelectorAll('.issue-table tbody tr').forEach(recalcRow);
  refreshSubmit();
})();
</script>
<% } %>
<%- include('partials/foot') %>
