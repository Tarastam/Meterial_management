<%- include('partials/head', { title: 'Record Data - Material Management' }) %>
<h1>Record Data</h1>

<% if (error) { %><div class="alert error"><%= error %></div><% } %>
<% if (success) { %><div class="alert success">Issue entries recorded successfully.</div><% } %>
<% if (negativeUsage) { %>
<div class="alert error">
  <strong>Not saved — usage would come out negative for these materials. Correct the Current Stock / Issue values before submitting:</strong>
  <ul>
    <% negativeUsage.forEach(w => { %>
    <li><%= w.code %> - <%= w.name %>: usage <%= fmtNum(w.usage) %></li>
    <% }) %>
  </ul>
</div>
<% } %>

<div class="filters">
  <form method="get" action="/issue" style="display:contents;">
    <div class="field" style="margin-bottom:0;">
      <label>Workshop</label>
      <select name="workshop" onchange="this.form.submit()">
        <option value="">All Workshops</option>
        <% workshops.forEach(w => { %>
        <option value="<%= w %>" <%= w === selectedWorkshop ? 'selected' : '' %>><%= w %></option>
        <% }) %>
      </select>
    </div>
    <% if (isAdmin) { %>
    <div class="field" style="margin-bottom:0;">
      <label>Date</label>
      <input type="date" name="date" value="<%= entryDate %>" onchange="this.form.submit()">
    </div>
    <% } %>
  </form>
  <div class="field" style="margin-bottom:0; max-width:420px;">
    <label>Search</label>
    <input type="text" id="materialSearch" placeholder="Filter by code or name" oninput="filterIssueRows(this.value)">
  </div>
</div>
<% if (isAdmin && entryDate !== today) { %>
<div class="alert error">Backdating entries to <%= entryDate %> (admin mode).</div>
<% } %>

<% if (!materials.length) { %>
<div class="card empty-state">No materials found. <a href="/materials/new">Add a material first</a>.</div>
<% } else { %>
<form method="post" action="/issue">
  <input type="hidden" name="workshop" value="<%= selectedWorkshop %>">
  <input type="hidden" name="entry_date" value="<%= entryDate %>">
  <div class="table-wrap">
    <table class="issue-table">
      <thead>
        <tr>
          <th>Code</th><th class="col-erp">ERP Code</th><th class="col-name">Name</th><th class="col-center">Unit</th><th class="col-center">Workshop</th>
          <th class="col-input" title="If left blank, the previous day's value is saved automatically">Current Stock</th><th class="col-input">Issue</th><th class="col-input">Issue NCN</th><th class="col-input">Return NCN</th>
        </tr>
      </thead>
      <tbody>
        <% materials.forEach(m => { %>
        <% const v = values[m.id] || {}; %>
        <tr data-search="<%= (m.prod_material_code + ' ' + m.material_code + ' ' + m.name).toLowerCase() %>">
          <td><%= m.prod_material_code %></td>
          <td class="col-erp"><%= m.material_code %></td>
          <td class="col-name"><%= m.name %></td>
          <td class="col-center"><%= m.unit %></td>
          <td class="col-center"><%= m.workshop %></td>
          <td class="col-input"><input type="number" step="any" min="0" name="current_stock_<%= m.id %>" value="<%= v.current_stock || '' %>" placeholder="<%= stockMap[m.id] != null ? fmtNum(stockMap[m.id]) : '' %>"></td>
          <td class="col-input"><input type="number" step="any" min="0" name="issue_qty_<%= m.id %>" value="<%= v.issue_qty || '' %>"></td>
          <td class="col-input"><input type="number" step="any" min="0" name="issue_ncn_<%= m.id %>" value="<%= v.issue_ncn || '' %>"></td>
          <td class="col-input"><input type="number" step="any" min="0" name="return_ncn_<%= m.id %>" value="<%= v.return_ncn || '' %>"></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <div class="issue-footer">
    <div class="field">
      <label>Employee ID *</label>
      <input type="text" name="employee_id" pattern="\d{7}|admin" maxlength="7" placeholder="7-digit ID" value="<%= employeeId %>" required>
    </div>
    <div class="field">
      <label>Shift *</label>
      <select name="shift" required>
        <option value="">Select shift...</option>
        <% shifts.forEach(s => { %>
        <option value="<%= s %>" <%= shift === s ? 'selected' : '' %>><%= s %></option>
        <% }) %>
      </select>
    </div>
    <button class="btn" type="submit">Submit</button>
  </div>
</form>
<script>
function filterIssueRows(query) {
  const q = query.trim().toLowerCase();
  document.querySelectorAll('.issue-table tbody tr').forEach(row => {
    row.style.display = !q || row.dataset.search.includes(q) ? '' : 'none';
  });
}
</script>
<% } %>
<%- include('partials/foot') %>
