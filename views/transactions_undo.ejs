<%- include('partials/head', { title: 'Undo / Change - Material Management' }) %>
<h1>Undo / Change</h1>

<% if (error) { %><div class="alert error"><%= error %></div><% } %>
<% if (success) { %>
<div class="alert success">Saved. A ticket was logged for admin review.</div>
<% } %>
<% if (negativeUsage) { %>
<div class="alert error">
  <strong>Not saved — usage would come out negative for these materials. Correct the values before submitting:</strong>
  <ul>
    <% negativeUsage.forEach(w => { %>
    <li><%= w.code %> - <%= w.name %>: usage <%= fmtNum(w.usage) %></li>
    <% }) %>
  </ul>
</div>
<% } %>

<form class="filters" method="get" action="/transactions/undo">
  <div class="field" style="margin-bottom:0;">
    <label>Date</label>
    <input type="date" name="entry_date" value="<%= entryDate %>" max="<%= todayBiz %>" onchange="this.form.submit()">
  </div>
  <div class="field" style="margin-bottom:0;">
    <label>Workshop</label>
    <select name="workshop" onchange="this.form.submit()">
      <option value="">Select workshop...</option>
      <% workshops.forEach(w => { %>
      <option value="<%= w %>" <%= w === workshop ? 'selected' : '' %>><%= w %></option>
      <% }) %>
    </select>
  </div>
  <div class="field" style="margin-bottom:0;">
    <label>Material</label>
    <select name="material_id" onchange="this.form.submit()" <%= !workshop ? 'disabled' : '' %>>
      <option value="">Select material...</option>
      <% materials.forEach(m => { %>
      <option value="<%= m.id %>" <%= materialId === m.id ? 'selected' : '' %>><%= m.prod_material_code %> - <%= m.name %></option>
      <% }) %>
    </select>
  </div>
</form>

<% if (!workshop) { %>
<div class="card empty-state">Select a workshop to continue.</div>
<% } else if (!materials.length) { %>
<div class="card empty-state">
  No existing entries to change for <%= entryDate %> in this workshop.
</div>
<% } %>

<% if (workshop && materialId && selectedEntry) { %>
<% const v = values[materialId] || {}; %>
<form class="card form-card" method="post" action="/transactions/undo">
  <input type="hidden" name="entry_date" value="<%= entryDate %>">
  <input type="hidden" name="workshop" value="<%= workshop %>">
  <input type="hidden" name="material_id" value="<%= materialId %>">

  <p><strong><%= selectedMaterial.prod_material_code %></strong> — <%= selectedMaterial.name %> (<%= entryDate %>)</p>

  <div class="field">
    <label>Current Stock</label>
    <input type="number" step="any" min="0" name="current_stock"
      value="<%= v.current_stock !== undefined ? v.current_stock : (selectedEntry.current_stock != null ? selectedEntry.current_stock : '') %>"
      placeholder="<%= stockMap[materialId] != null ? fmtNum(stockMap[materialId]) : '' %>">
  </div>
  <div class="field">
    <label>Issue</label>
    <input type="number" step="any" min="0" name="issue_qty"
      value="<%= v.issue_qty !== undefined ? v.issue_qty : (selectedEntry.issue_qty != null ? selectedEntry.issue_qty : '') %>">
  </div>
  <div class="field">
    <label>Issue NCN</label>
    <input type="number" step="any" min="0" name="issue_ncn"
      value="<%= v.issue_ncn !== undefined ? v.issue_ncn : (selectedEntry.issue_ncn != null ? selectedEntry.issue_ncn : '') %>">
  </div>
  <div class="field">
    <label>Return NCN</label>
    <input type="number" step="any" min="0" name="return_ncn"
      value="<%= v.return_ncn !== undefined ? v.return_ncn : (selectedEntry.return_ncn != null ? selectedEntry.return_ncn : '') %>">
  </div>
  <div class="field">
    <label>Employee ID *</label>
    <input type="text" name="employee_id" pattern="\d{7}|admin" maxlength="7" placeholder="7-digit ID" value="<%= employeeId %>" required>
  </div>
  <div class="field">
    <label>Shift *</label>
    <select name="shift" required>
      <option value="">Select shift...</option>
      <% shifts.forEach(s => { %>
      <option value="<%= s %>" <%= shift === s ? 'selected' : '' %>><%= s %></option>
      <% }) %>
    </select>
  </div>
  <button class="btn" type="submit">Submit Correction</button>
</form>
<% } %>

<%- include('partials/foot') %>
