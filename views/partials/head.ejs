<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title : 'Material Management' %></title>
  <link rel="icon" type="image/png" sizes="32x32" href="/static/favicon-32.png">
  <link rel="icon" type="image/png" sizes="48x48" href="/static/favicon-48.png">
  <link rel="apple-touch-icon" href="/static/apple-touch-icon.png">
  <link rel="stylesheet" href="/static/style.css">
</head>
<body>
  <nav>
    <span class="brand">Material Management</span>
    <a href="/">Dashboard</a>
    <div class="nav-dropdown">
      <button type="button" class="nav-dropdown-toggle">Stock Control</button>
      <div class="nav-dropdown-menu">
        <a href="/issue">Record Data</a>
        <a href="/materials">Summary</a>
        <div class="nav-submenu">
          <span class="nav-submenu-toggle">Transaction</span>
          <div class="nav-submenu-menu">
            <a href="/transactions">Transaction Log</a>
            <a href="/transactions/undo">Undo/Change</a>
          </div>
        </div>
        <a href="/consumption">Consumption</a>
        <a href="/reports/monthly-consumption">Monthly Report</a>
        <% if (can('process_map')) { %>
        <a href="/process-map">Process Mapping</a>
        <% } %>
      </div>
    </div>
    <div class="nav-dropdown">
      <button type="button" class="nav-dropdown-toggle">Material Request</button>
      <div class="nav-dropdown-menu">
        <a href="/material-request/1st-production">1st Production</a>
        <a href="/material-request/2nd-production">2nd Production</a>
      </div>
    </div>
    <div class="nav-dropdown">
      <button type="button" class="nav-dropdown-toggle">Request Change</button>
      <div class="nav-dropdown-menu">
        <a href="/tickets/new">Create Ticket</a>
        <a href="/tickets">Ticket Log</a>
      </div>
    </div>
    <% if (isMaster) { %>
    <a href="/admin/users">User Management</a>
    <% } %>
    <div class="nav-right">
      <% if (currentUser) { %>
      <form class="inline nav-logout" method="post" action="/admin/logout">
        <span class="nav-admin-badge"><%= currentUser.username %></span>
        <button class="nav-link-btn" type="submit">Logout</button>
      </form>
      <% } else { %>
      <a href="/admin/login">Admin Login</a>
      <% } %>
    </div>
  </nav>
  <script>
    document.querySelectorAll('.nav-dropdown-toggle').forEach(function (btn) {
      btn.addEventListener('click', function (e) {
        e.stopPropagation();
        var dropdown = btn.closest('.nav-dropdown');
        var wasOpen = dropdown.classList.contains('open');
        document.querySelectorAll('.nav-dropdown.open').forEach(function (d) { d.classList.remove('open'); });
        if (!wasOpen) dropdown.classList.add('open');
      });
    });
    document.addEventListener('click', function () {
      document.querySelectorAll('.nav-dropdown.open').forEach(function (d) { d.classList.remove('open'); });
    });
  </script>
  <main>
