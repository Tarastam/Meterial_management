<%- include('partials/head', { title: 'Dashboard - Material Management' }) %>
<%
function fmtMoney(n) {
  if (n === null || n === undefined || isNaN(n)) return '-';
  return Number(n).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}
function fmtMoney0(n) {
  if (n === null || n === undefined || isNaN(n)) return '-';
  return Number(n).toLocaleString(undefined, { minimumFractionDigits: 0, maximumFractionDigits: 0 });
}
%>
<h1>Dashboard</h1>

<div class="trend-filter-row">
  <div>
    <h2>Material Trends</h2>
    <div class="card">
      <div class="chart-toggle">
        <button type="button" class="btn small secondary chart-toggle-btn" data-series="issue">Issue (Daily)</button>
        <button type="button" class="btn small secondary chart-toggle-btn active" data-series="usage">Usage (Daily)</button>
      </div>
      <% if (dailyChartData.materials.length) { %>
      <canvas id="dailyChart" height="90" role="img" aria-label="Daily material issue or usage for the selected period, stacked by material"></canvas>
      <% } else { %>
      <div class="empty-state">No data in this period.</div>
      <% } %>
    </div>
  </div>
  <div>
    <h2>Filters</h2>
    <div class="card">
      <form class="filters stacked" method="get" action="/">
        <div class="field">
          <label>Search</label>
          <input type="text" name="q" value="<%= filters.q %>" placeholder="Code or name">
        </div>
        <div class="field">
          <label>Workshop</label>
          <select name="workshop" onchange="this.form.submit()">
            <option value="">All Workshops</option>
            <% workshops.forEach(w => { %>
            <option value="<%= w %>" <%= filters.workshop === w ? 'selected' : '' %>><%= w %></option>
            <% }) %>
          </select>
        </div>
        <div class="field">
          <label>Material</label>
          <select name="material_id">
            <option value="">All Materials</option>
            <% materials.forEach(m => { %>
            <option value="<%= m.id %>" <%= String(filters.material_id) === String(m.id) ? 'selected' : '' %>><%= m.prod_material_code %> - <%= m.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="field">
          <label>Shift</label>
          <select name="shift">
            <option value="">All</option>
            <% shifts.forEach(s => { %>
            <option value="<%= s %>" <%= filters.shift === s ? 'selected' : '' %>><%= s %></option>
            <% }) %>
          </select>
        </div>
        <div class="field">
          <label>From Date</label>
          <input type="date" name="from" value="<%= filters.from %>">
        </div>
        <div class="field">
          <label>To Date</label>
          <input type="date" name="to" value="<%= filters.to %>">
        </div>
        <button class="btn secondary" type="submit" style="width:100%;">Apply</button>
      </form>
    </div>
  </div>
</div>

<h2>Abnormal Usage</h2>
<% if (usageAnomalies.length) { %>
<div class="table-wrap">
  <table>
    <thead>
      <tr><th>Date</th><th>Code</th><th>Name</th><th>Workshop</th><th>Usage</th><th>Baseline (14d)</th><th>Deviation</th><th>Severity</th></tr>
    </thead>
    <tbody>
      <% usageAnomalies.forEach(a => { %>
      <tr>
        <td><%= a.date %></td>
        <td><%= a.material.prod_material_code %></td>
        <td><%= a.material.name %></td>
        <td><%= a.material.workshop %></td>
        <td><%= fmtNum(a.usage) %> <%= a.material.unit %></td>
        <td><%= fmtNum(a.baseline) %> <%= a.material.unit %></td>
        <td><%= a.deviationPct !== null ? (a.deviationPct > 0 ? '+' : '') + fmtNum(a.deviationPct, 0) + '%' : '-' %></td>
        <td><span class="badge <%= a.severity %>"><%= a.severity === 'severe' ? 'Severe' : 'Moderate' %></span></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<% } else { %>
<div class="card empty-state">No unusual usage detected in this period.</div>
<% } %>

<h2>Month-over-Month Comparison</h2>
<div class="card">
  <canvas id="monthCompareChart" height="80" role="img" aria-label="Total issue and usage this month versus last month, stacked"></canvas>
  <div class="table-wrap" style="margin-top:1rem;">
    <table>
      <thead>
        <tr><th>Metric</th><th>This Month</th><th>Last Month</th><th>Change</th></tr>
      </thead>
      <tbody>
        <tr>
          <td>Issue</td>
          <td><%= fmtNum(curMonthTotals.issue, 1) %></td>
          <td><%= fmtNum(prevMonthTotals.issue, 1) %></td>
          <td class="stock-hint"><%= fmtNum(curMonthTotals.issue - prevMonthTotals.issue, 1) %></td>
        </tr>
        <tr>
          <td>Usage</td>
          <td><%= fmtNum(curMonthTotals.usage, 1) %></td>
          <td><%= fmtNum(prevMonthTotals.usage, 1) %></td>
          <td class="stock-hint"><%= fmtNum(curMonthTotals.usage - prevMonthTotals.usage, 1) %></td>
        </tr>
      </tbody>
    </table>
  </div>
</div>

<h2>Cost Overview</h2>
<div class="cost-columns">
  <div class="card">
    <h3>Cost Distribution by Material</h3>
    <% if (costRows.some(r => r.value > 0)) { %>
    <canvas id="costDonutChart" height="160" role="img" aria-label="Usage cost distribution by material"></canvas>
    <% } else { %>
    <div class="empty-state">No cost data available.</div>
    <% } %>
  </div>
  <div class="card">
    <div class="actions-row">
      <h3>Materials by Usage Cost</h3>
      <% const costQs = new URLSearchParams(
           Object.entries({
             q: filters.q,
             workshop: filters.workshop,
             material_id: filters.material_id,
             from: filters.from,
             to: filters.to,
           }).filter(([, v]) => v)
         ).toString(); %>
      <a class="btn small secondary" href="/export/cost.csv<%= costQs ? '?' + costQs : '' %>">Export CSV</a>
    </div>
    <% if (costRows.length) { %>
    <div class="table-wrap cost-table cost-table-scroll">
      <table>
        <thead>
          <tr><th>Code</th><th>Name</th><th>Workshop</th><th>Usage</th><th>Usage Cost</th><th>Unit Cost</th></tr>
        </thead>
        <tbody>
          <% costRows.forEach(row => { %>
          <tr>
            <td><%= row.material.prod_material_code %></td>
            <td><%= row.material.name %></td>
            <td><%= row.material.workshop %></td>
            <td><%= fmtNum(row.usage) %> <%= row.material.unit %></td>
            <td><%= fmtMoney0(row.value) %></td>
            <td><%= fmtMoney(row.cost) %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } else { %>
    <div class="empty-state">No cost data available.</div>
    <% } %>
  </div>
</div>

<h2>Top 5 Issued Materials (Last 30 Days)</h2>
<% if (topIssuedRows.length) { %>
<div class="card">
  <% topIssuedRows.forEach(row => { %>
  <div class="bar-row">
    <div class="bar-label"><%= row.prod_material_code %> - <%= row.name %></div>
    <div class="bar-track"><div class="bar-fill" style="width: <%= (row.total_out / maxOut * 100).toFixed(1) %>%"></div></div>
    <div class="bar-value"><%= fmtNum(row.total_out) %></div>
  </div>
  <% }) %>
</div>
<% } else { %>
<div class="card empty-state">No stock-out activity in the last 30 days.</div>
<% } %>

<h2>Recent Transactions</h2>
<% if (recentTransactions.length) { %>
<div class="table-wrap">
  <table>
    <thead>
      <tr><th>Date</th><th>Material</th><th>Current Stock</th><th>Issue</th><th>Employee ID</th></tr>
    </thead>
    <tbody>
      <% recentTransactions.forEach(t => { %>
      <tr>
        <td><%= fmtDate(t.created_at) %><% if (t.voided) { %> <span class="badge voided">VOIDED</span><% } %></td>
        <td><%= t.prod_material_code %> - <%= t.material_name %></td>
        <td><%= t.current_stock != null ? fmtNum(t.current_stock) + ' ' + t.material_unit : '-' %></td>
        <td><%= t.issue_qty != null ? fmtNum(t.issue_qty) + ' ' + t.material_unit : '-' %></td>
        <td><%= t.employee_id %></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<% } else { %>
<div class="card empty-state">No transactions yet.</div>
<% } %>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<script>
  const dailyChartData = <%- JSON.stringify(dailyChartData) %>;
  const curMonthTotals = <%- JSON.stringify(curMonthTotals) %>;
  const prevMonthTotals = <%- JSON.stringify(prevMonthTotals) %>;
  const costByMaterial = <%- JSON.stringify(costRows.filter(r => r.value > 0).map(r => ({ label: r.material.name, value: r.value }))) %>;

  const dailyCanvas = document.getElementById('dailyChart');
  if (dailyCanvas) {
    const materialPalette = ['#2563eb', '#16a34a', '#d97706', '#dc2626', '#7c3aed', '#0891b2', '#db2777', '#65a30d', '#475569', '#0f766e'];
    let dailySeries = 'usage';
    const dailyChart = new Chart(dailyCanvas, {
      type: 'bar',
      data: {
        labels: dailyChartData.dates,
        datasets: dailyChartData.materials.map((m, i) => ({
          label: m.label,
          data: m[dailySeries],
          backgroundColor: materialPalette[i % materialPalette.length],
          borderRadius: 2,
        })),
      },
      options: {
        responsive: true,
        plugins: { legend: { display: false } },
        scales: { x: { stacked: true }, y: { stacked: true, beginAtZero: true } },
      },
    });

    document.querySelectorAll('.chart-toggle-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.chart-toggle-btn').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        dailySeries = btn.dataset.series;
        dailyChart.data.datasets.forEach((ds, i) => { ds.data = dailyChartData.materials[i][dailySeries]; });
        dailyChart.update();
      });
    });
  }

  const compareCanvas = document.getElementById('monthCompareChart');
  if (compareCanvas) {
    new Chart(compareCanvas, {
      type: 'bar',
      data: {
        labels: ['Issue', 'Usage'],
        datasets: [
          { label: 'This Month', data: [curMonthTotals.issue, curMonthTotals.usage], backgroundColor: '#2563eb', borderRadius: 4 },
          { label: 'Last Month', data: [prevMonthTotals.issue, prevMonthTotals.usage], backgroundColor: '#475569', borderRadius: 4 },
        ],
      },
      options: {
        responsive: true,
        plugins: { legend: { display: true, position: 'bottom' } },
        scales: { x: { stacked: true }, y: { stacked: true, beginAtZero: true } },
      },
    });
  }

  const donutCanvas = document.getElementById('costDonutChart');
  if (donutCanvas) {
    const palette = ['#2563eb', '#16a34a', '#d97706', '#dc2626', '#7c3aed', '#0891b2', '#db2777', '#65a30d', '#475569', '#0f766e'];
    new Chart(donutCanvas, {
      type: 'doughnut',
      data: {
        labels: costByMaterial.map((r) => r.label),
        datasets: [
          { data: costByMaterial.map((r) => r.value), backgroundColor: costByMaterial.map((_, i) => palette[i % palette.length]) },
        ],
      },
      options: {
        responsive: true,
        plugins: { legend: { display: true, position: 'right' } },
      },
    });
  }
</script>
<%- include('partials/foot') %>
