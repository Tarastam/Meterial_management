<%- include('partials/head', { title: 'Ticket Log - Material Management' }) %>
<div class="actions-row">
  <h1>Ticket Log</h1>
  <div class="kpi" style="padding:0.6rem 1.1rem;">
    <div class="value" style="font-size:1.4rem;"><%= openCount %></div>
    <div class="label">Open</div>
  </div>
</div>

<div class="card">
  <h3>Tickets by Workshop</h3>
  <canvas id="ticketsByWorkshopChart" height="110" role="img" aria-label="Number of tickets per workshop, stacked by shift"></canvas>
</div>

<form class="filters" method="get" action="/tickets">
  <div class="field" style="margin-bottom:0;">
    <label>Status</label>
    <select name="status" onchange="this.form.submit()">
      <option value="">All</option>
      <option value="OPEN" <%= status === 'OPEN' ? 'selected' : '' %>>Open</option>
      <option value="RESOLVED" <%= status === 'RESOLVED' ? 'selected' : '' %>>Resolved</option>
    </select>
  </div>
  <div class="field" style="margin-bottom:0;">
    <label>Type</label>
    <select name="type" onchange="this.form.submit()">
      <option value="">All</option>
      <option value="MANUAL" <%= type === 'MANUAL' ? 'selected' : '' %>>Manual</option>
      <option value="CHANGE" <%= type === 'CHANGE' ? 'selected' : '' %>>Change</option>
      <option value="CREATE" <%= type === 'CREATE' ? 'selected' : '' %>>Create</option>
    </select>
  </div>
  <div class="field" style="margin-bottom:0;">
    <label>From Date</label>
    <input type="date" name="date_from" value="<%= dateFrom %>">
  </div>
  <div class="field" style="margin-bottom:0;">
    <label>To Date</label>
    <input type="date" name="date_to" value="<%= dateTo %>">
  </div>
  <div class="field" style="margin-bottom:0; align-self:flex-end;">
    <button class="btn secondary" type="submit">Apply</button>
  </div>
</form>

<div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th>Date</th><th>Type</th><th>Emp No.</th><th>Shift</th><th>Workshop</th>
        <th>Detail</th><th>Attachment</th><th>Status</th><th></th>
      </tr>
    </thead>
    <tbody>
      <% tickets.forEach(t => { %>
      <tr>
        <td><%= fmtDate(t.created_at) %></td>
        <td><span class="badge type-<%= t.type.toLowerCase() %>"><%= t.type %></span></td>
        <td><%= t.emp_no %></td>
        <td><%= t.shift %></td>
        <td><%= t.workshop %></td>
        <td class="detail-cell">
          <span class="detail-text"><%= t.detail %></span>
        </td>
        <td>
          <% if (t.attachment_path) { %>
          <a href="/tickets/<%= t.id %>/attachment"><%= t.attachment_name %></a>
          <% } %>
        </td>
        <td>
          <% if (t.status === 'OPEN') { %>
          <span class="badge open">OPEN</span>
          <% } else { %>
          <span class="badge resolved" title="<%= t.resolved_note %>">RESOLVED</span>
          <% } %>
        </td>
        <td class="actions-cell">
          <button type="button" class="btn small secondary" onclick="showTicketDetail(event, this)"
            data-id="<%= t.id %>"
            data-type="<%= t.type %>"
            data-date="<%= fmtDate(t.created_at) %>"
            data-emp-no="<%= t.emp_no %>"
            data-shift="<%= t.shift %>"
            data-workshop="<%= t.workshop %>"
            data-detail="<%= t.detail %>"
            data-status="<%= t.status %>"
            data-resolved-note="<%= t.resolved_note || '' %>"
            data-attachment-name="<%= t.attachment_name || '' %>"
            data-attachment-url="<%= t.attachment_path ? ('/tickets/' + t.id + '/attachment') : '' %>"
          >Detail</button>
          <% if (isAdmin && t.status === 'OPEN') { %>
          <form class="inline" method="post" action="/tickets/<%= t.id %>/resolve" onsubmit="return handleResolve(event, this);">
            <button class="btn small secondary" type="submit">Resolve</button>
          </form>
          <% } %>
          <% if (isAdmin) { %>
          <form class="inline" method="post" action="/tickets/<%= t.id %>/delete" onsubmit="return confirm('Delete this ticket permanently? This cannot be undone.');">
            <button class="btn small danger" type="submit">Delete</button>
          </form>
          <% } %>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<% if (!tickets.length) { %>
<div class="card empty-state">No tickets found.</div>
<% } %>

<div class="modal-overlay" id="ticketDetailOverlay" onclick="if (event.target === this) closeTicketDetail();">
  <div class="modal">
    <div class="modal-header">
      <div>
        <h2>Ticket <span id="ticketDetailId"></span></h2>
        <div class="modal-subtitle" id="ticketDetailDate"></div>
      </div>
      <span class="badge" id="ticketDetailStatus"></span>
      <button type="button" class="modal-close" onclick="closeTicketDetail()" aria-label="Close">&times;</button>
    </div>
    <div class="modal-body">
      <div class="modal-meta-grid">
        <div class="modal-meta-item">
          <span class="modal-meta-label">Type</span>
          <span class="modal-meta-value" id="ticketDetailType"></span>
        </div>
        <div class="modal-meta-item">
          <span class="modal-meta-label">Emp No.</span>
          <span class="modal-meta-value" id="ticketDetailEmpNo"></span>
        </div>
        <div class="modal-meta-item">
          <span class="modal-meta-label">Shift</span>
          <span class="modal-meta-value" id="ticketDetailShift"></span>
        </div>
        <div class="modal-meta-item">
          <span class="modal-meta-label">Workshop</span>
          <span class="modal-meta-value" id="ticketDetailWorkshop"></span>
        </div>
      </div>
      <div class="modal-section">
        <span class="modal-meta-label">Detail</span>
        <div class="modal-detail-box" id="ticketDetailDetail"></div>
      </div>
      <div class="modal-section" id="ticketDetailAttachmentField" style="display:none;">
        <span class="modal-meta-label">Attachment</span>
        <a class="modal-attachment-chip" id="ticketDetailAttachmentLink" href="#" target="_blank">
          <span id="ticketDetailAttachmentName"></span>
        </a>
      </div>
      <div class="modal-section" id="ticketDetailResolvedField" style="display:none;">
        <span class="modal-meta-label">Resolution Note</span>
        <div class="modal-detail-box" id="ticketDetailResolvedNote"></div>
      </div>
    </div>
    <div class="modal-footer">
      <button type="button" class="btn secondary" onclick="closeTicketDetail()">Close</button>
    </div>
  </div>
</div>

<script>
function handleResolve(event, form) {
  const note = prompt('Resolution note (optional):');
  if (note === null) { event.preventDefault(); return false; }
  const input = document.createElement('input');
  input.type = 'hidden';
  input.name = 'resolved_note';
  input.value = note;
  form.appendChild(input);
  return true;
}

function showTicketDetail(event, link) {
  document.getElementById('ticketDetailId').textContent = '#' + link.dataset.id;
  document.getElementById('ticketDetailType').textContent = link.dataset.type;
  document.getElementById('ticketDetailDate').textContent = link.dataset.date;
  document.getElementById('ticketDetailEmpNo').textContent = link.dataset.empNo;
  document.getElementById('ticketDetailShift').textContent = link.dataset.shift;
  document.getElementById('ticketDetailWorkshop').textContent = link.dataset.workshop;
  document.getElementById('ticketDetailDetail').textContent = link.dataset.detail;

  const statusEl = document.getElementById('ticketDetailStatus');
  const isOpen = link.dataset.status === 'OPEN';
  statusEl.textContent = link.dataset.status;
  statusEl.className = 'badge ' + (isOpen ? 'open' : 'resolved');

  const attachmentField = document.getElementById('ticketDetailAttachmentField');
  const attachmentLink = document.getElementById('ticketDetailAttachmentLink');
  if (link.dataset.attachmentUrl) {
    attachmentField.style.display = '';
    attachmentLink.href = link.dataset.attachmentUrl;
    document.getElementById('ticketDetailAttachmentName').textContent = link.dataset.attachmentName;
  } else {
    attachmentField.style.display = 'none';
  }

  const resolvedField = document.getElementById('ticketDetailResolvedField');
  if (!isOpen && link.dataset.resolvedNote) {
    resolvedField.style.display = '';
    document.getElementById('ticketDetailResolvedNote').textContent = link.dataset.resolvedNote;
  } else {
    resolvedField.style.display = 'none';
  }

  document.getElementById('ticketDetailOverlay').classList.add('show');
}

function closeTicketDetail() {
  document.getElementById('ticketDetailOverlay').classList.remove('show');
}
</script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<script>
  const workshopShiftCounts = <%- JSON.stringify(workshopShiftCounts) %>;
  const shiftPalette = ['#2563eb', '#16a34a', '#d97706'];

  const workshopCanvas = document.getElementById('ticketsByWorkshopChart');
  if (workshopCanvas) {
    new Chart(workshopCanvas, {
      type: 'bar',
      data: {
        labels: workshopShiftCounts.workshops,
        datasets: workshopShiftCounts.series.map((s, i) => ({
          label: 'Shift ' + s.shift,
          data: s.counts,
          backgroundColor: shiftPalette[i % shiftPalette.length],
          borderRadius: 2,
        })),
      },
      options: {
        responsive: true,
        plugins: { legend: { display: true, position: 'bottom' } },
        scales: { x: { stacked: true }, y: { stacked: true, beginAtZero: true, ticks: { precision: 0 } } },
      },
    });
  }
</script>
<%- include('partials/foot') %>
